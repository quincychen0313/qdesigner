        [
          "view.newGuideLayout",
          {
            "columns": 12,
            "rows": 12,
            "gutter": 20,
            "clearExisting": true
          }
        ]
      ]
    },
    {
      "name": "Resize · Instagram (Landscape) — 1080 x 566",
      "steps": [
        [
          "file.automate.fitImage",
          {
            "width": 1080,
            "height": 566,
            "resample": "lanczos"
          }
        ],
        [
          "image.canvasSize",
          {
            "width": 1080,
            "height": 566,
            "anchor": "center",
            "extensionColor": "transparent"
          }
        ],
        [
          "view.fitOnScreen",
          {}
        ]
      ]
    },
    {
