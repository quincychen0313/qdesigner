{
  "version": 1,
  "actions": [
    {
      "name": "Creative Effects · Enhance clarity",
      "steps": [
        [
          "layer.duplicate",
          {}
        ],
        [
          "layer.setProps",
          {
            "name": "Enhance clarity"
          }
        ],
        [
          "filter.cameraRaw",
          {
            "clarity": 25
          }
        ]
      ]
    },
    {
      "name": "Creative Effects · Sharpen",
      "steps": [
        [
          "layer.duplicate",
          {}
        ],
        [
          "layer.setProps",
          {
            "name": "Sharpen"
          }
        ],
        [
          "filter.sharpen.unsharpMask",
          {
            "amount": 80,
            "radius": 1.2,
            "threshold": 2
          }
        ]
      ]
    },
    {
      "name": "Creative Effects · Add vignette",
      "steps": [
        [
          "layer.duplicate",
          {}
        ],
        [
          "layer.setProps",
          {
            "name": "Add vignette"
          }
        ],
        [
          "filter.cameraRaw",
          {
            "vignetteAmount": -30,
            "vignetteMidpoint": 45,
            "vignetteFeather": 70
          }
        ]
      ]
    },
    {
      "name": "Creative Effects · Add grain",
      "steps": [
        [
          "layer.duplicate",
          {}
        ],
        [
          "layer.setProps",
          {
            "name": "Add grain"
          }
        ],
        [
          "filter.cameraRaw",
          {
            "grainAmount": 25,
            "grainSize": 25,
            "grainRoughness": 50,
            "seed": 31415
          }
        ]
      ]
    },
    {
      "name": "Creative Effects · Black & white",
      "steps": [
        [
          "layer.newAdjustmentLayer.blackWhite",
          {
            "name": "Black & white"
          }
        ]
      ]
    },
    {
      "name": "Creative Effects · Setup dodge & burn",
      "steps": [
        [
          "layer.new.layer",
          {
            "name": "Dodge & Burn — paint white / black"
          }
        ],
        [
          "edit.fill",
          {
            "contents": "gray",
            "target": "pixels"
          }
        ],
        [
          "layer.setProps",
          {
            "blend": "Soft Light",
            "opacity": 1
          }
        ]
      ]
    },
    {
      "name": "Guides · Remove all",
      "steps": [
        [
          "view.clearGuides",
          {}
        ]
      ]
    },
    {
      "name": "Guides · Centerlines",
      "steps": [
        [
          "view.newGuideLayout",
          {
            "columns": 2,
            "rows": 2,
            "gutter": 0,
            "clearExisting": true
          }
        ]
      ]
    },
    {
      "name": "Guides · Thirds",
      "steps": [
        [
          "view.newGuideLayout",
          {
            "columns": 3,
            "rows": 3,
            "gutter": 0,
            "clearExisting": true
          }
        ]
      ]
    },
    {
      "name": "Guides · Thirds (with gutters)",
      "steps": [
        [
          "view.newGuideLayout",
          {
            "columns": 3,
            "rows": 3,
            "gutter": 20,
            "clearExisting": true
          }
        ]
      ]
    },
    {
      "name": "Guides · 4x4 grid",
      "steps": [
        [
          "view.newGuideLayout",
          {
            "columns": 4,
            "rows": 4,
            "gutter": 0,
            "clearExisting": true
          }
        ]
      ]
    },
    {
      "name": "Guides · 4x4 grid (with gutters)",
      "steps": [
        [
          "view.newGuideLayout",
          {
            "columns": 4,
            "rows": 4,
            "gutter": 20,
            "clearExisting": true
          }
        ]
      ]
    },
    {
      "name": "Guides · 12x12 grid",
      "steps": [
