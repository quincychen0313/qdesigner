+//! Searchable, single-click Actions library in the docked column.
+use crate::{PhotocraftApp, theme::Tokens};
+use egui::{Align2, FontId, Rect, Sense, Stroke, pos2, vec2};
+use serde_json::json;
+
+const GROUPS: [&str; 4] = ["Creative Effects", "Guides", "Resize", "Export"];
+
+fn category(name: &str) -> Option<(&str, &str)> {
+    let (group, label) = name.split_once(" · ")?;
+    GROUPS.contains(&group).then_some((group, label))
+}
+
+fn icon(group: &str, label: &str) -> &'static str {
+    match group {
+        "Guides" => "grid-3x3",
+        "Resize" => "crop",
+        "Export" => "file",
+        _ => match label {
+            "Sharpen" => "triangle",
+            "Add vignette" => "circle",
+            "Add grain" => "droplet",
+            "Black & white" => "contrast",
+            "Setup dodge & burn" => "blend",
+            _ => "sparkles",
+        },
+    }
+}
+
+pub fn panel(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    if app.ui.actions.library_editing {
+        if ui.button("‹ Back to Actions").clicked() {
+            app.ui.actions.library_editing = false;
+        }
+        crate::actions::panel(app, ui);
+        return;
+    }
+    let t = Tokens::get(ui.ctx());
+    ui.add_space(4.0);
+    ui.horizontal(|ui| {
+        let width = (ui.available_width() - 24.0 - ui.spacing().item_spacing.x).max(0.0);
+        let search =
+            ui.add_sized([width, 28.0], egui::TextEdit::singleline(&mut app.ui.actions.library_search).desired_width(width).hint_text("Search actions"));
+        search.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::TextEdit, true, "Search actions"));
+        if crate::icons::button(ui, "x", 24.0, false, "Clear search").clicked() {
+            app.ui.actions.library_search.clear();
+        }
+    });
+    ui.add_space(8.0);
+    ui.horizontal(|ui| {
+        ui.selectable_value(&mut app.ui.actions.library_yours, false, "Essentials");
+        ui.selectable_value(&mut app.ui.actions.library_yours, true, "Yours");
+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+            if crate::icons::button(ui, "plus", 24.0, false, "Record or edit actions").clicked() {
+                app.ui.actions.library_editing = true;
+            }
+        });
+    });
+    ui.separator();
+    let query = app.ui.actions.library_search.trim().to_lowercase();
+    let yours = app.ui.actions.library_yours;
+    let rows: Vec<_> = app
+        .session
+        .actions
+        .list
+        .iter()
+        .enumerate()
+        .filter_map(|(index, action)| {
+            let cat = category(&action.name);
+            if yours != cat.is_none() || !action.name.to_lowercase().contains(&query) {
+                return None;
+            }
+            let (group, label) = cat.unwrap_or(("Your actions", &action.name));
+            Some((index, group.to_owned(), label.to_owned(), action.name.clone()))
+        })
+        .collect();
+    let mut play = None;
+    let mut edit = None;
+    let height = ui.available_height().max(0.0);
+    egui::ScrollArea::vertical().id_salt("actions-library-list").max_height(height).auto_shrink([false, false]).show(ui, |ui| {
+        if rows.is_empty() {
+            ui.add_space(12.0);
+            ui.label(if query.is_empty() && yours { "Your recorded actions appear here. Use + to record or edit." } else { "No matching actions" });
+        }
+        let groups: Vec<&str> = if yours { vec!["Your actions"] } else { GROUPS.to_vec() };
+        for group in groups {
+            let group_rows: Vec<_> = rows.iter().filter(|r| r.1 == group).collect();
+            if group_rows.is_empty() {
+                continue;
+            }
+            ui.add_space(8.0);
+            let collapsed = query.is_empty() && app.ui.actions.library_collapsed.iter().any(|g| g == group);
+            let (rect, response) = ui.allocate_exact_size(vec2(ui.available_width(), 30.0), Sense::click());
+            response.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, group));
+            crate::icons::paint(
+                ui,
+                Rect::from_center_size(pos2(rect.left() + 8.0, rect.center().y), vec2(14.0, 14.0)),
+                if collapsed { "chevron-right" } else { "chevron-down" },
+                12.0,
+                t.text_dim,
+            );
+            ui.painter().text(pos2(rect.left() + 24.0, rect.center().y), Align2::LEFT_CENTER, group, FontId::proportional(12.5), t.text);
+            if response.clicked() {
+                if collapsed {
