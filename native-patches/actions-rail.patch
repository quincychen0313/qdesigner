+/// A docked, full-height column: expanding it reserves canvas space.
+pub fn actions_rail_column(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    if !app.ui.dock.actions_in_rail || !app.ui.panels.rail {
+        return;
+    }
+    let t = Tokens::get(ui.ctx());
+    if !app.ui.dock.actions_rail_open {
+        egui::Panel::right("actions-collapsed-rail").resizable(false).exact_size(36.0).frame(egui::Frame::NONE.fill(t.chrome).inner_margin(4)).show(ui, |ui| {
+            remember_rail_rect(ui.ctx(), ui.max_rect());
+            if crate::icons::button(ui, "chevrons-left", 28.0, false, "Expand panels").clicked() {
+                app.ui.dock.actions_rail_open = true;
+            }
